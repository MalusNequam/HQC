from Crypto.Hash import SHAKE256
from Crypto.Hash import SHA3_512
import komm
import numpy

DOMAIN_SEPERATOR = str(4)

class HQC: 
    def __init__(self, n, k_rm, r_rm, m_rm, w, w_e, w_r, l, DOMAIN_SEPERATOR, seed_pke, B):
        self.n = n
        self.k_rm = k_rm
        self.r_rm = r_rm
        self.m_rm = m_rm
        self.w = w
        self.w_e = w_e
        self.w_r = w_r
        self.l = l
        self.DOMAIN_SEPERATOR = DOMAIN_SEPERATOR
        self.seed_pke = seed_pke
        self.B = B # Parameter für randBits-Funktion
        self.S = PolynomialRing(GF(2), 'x')
        self.x = self.S.gen()
        self.R = self.S.quotient(self.x**self.n+1, 'X')
        self.X = self.R.gen()
        self.code = komm.ReedMullerCode(int(self.r_rm), int(self.m_rm))
        self.decoder = komm.ReedDecoder(self.code, "hard")
        self.byte_length = (self.n + 7) // 8

    def dec_from_ascii7(self, c): # nimmt Binärstring entgegen
        chars = []
        for i in range(0, len(c), 7):
            chunk = c[i:i+7]
            value = int(chunk, 2)
            chars.append(chr(value))

        return ''.join(chars)
    
    def remove_padding(self, m): # nimmt Binärstring entgegen
        ctr = int(m[:self.k_rm], 2)
        m = m[:-ctr]
        m = m[self.k_rm:]
        return m
    
    def bit_to_poly(self, bits):
        poly = sum(int(bits[i]) * self.x**i for i in range(len(bits)))
        return self.R(poly)

    def truncate(self, poly):
        coeffs = poly.list()
        trunc = coeffs[:self.l]
        trunc += [0]* (self.l - len(trunc))
        return numpy.array(trunc, dtype=numpy.int8) # gibt Numpy-Array zurück >> kompatibel mit komm
    
    def decrypt(self, c, key_priv):
        U = c[0]
        for i in range(0, len(U)):
            U[i] = self.bit_to_poly(U[i])
        V = c[1]
        y = self.bit_to_poly(key_priv[1])

        M = []
        for i in range(0, len(U)):
            w = (V[i] - self.truncate(U[i]*y)) % 2
            m = self.decoder.decode(w)
            M.append(m)
        M = ''.join(''.join(map(str, subarr)) for subarr in M)
        m_no_pad = self.remove_padding(M)
        m = self.dec_from_ascii7(m_no_pad)
        return m
